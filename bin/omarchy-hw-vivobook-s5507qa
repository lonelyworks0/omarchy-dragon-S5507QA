#!/bin/bash

# omarchy:summary=Install or remove Vivobook S15 X Plus speaker, volume, and suspend fixes, hide the iris decoder, and report iris firmware
# omarchy:args=[status|install|uninstall]
# omarchy:examples=omarchy hw vivobook s5507qa | omarchy hw vivobook s5507qa install | omarchy hw vivobook s5507qa uninstall

# ASUS Vivobook S 15 S5507QA (Snapdragon X Plus) is the device tree
# asus,vivobook-s15-x1p4. S5507QAD is the X Elite and is not this machine.
# The X Plus keeps its SoundWire speaker amps out of runtime suspend, caps
# speaker volume, and suspends to idle. Every Qualcomm machine also gets the
# WirePlumber rule that hides the iris decoder from PipeWire's camera list.
# That rule does not disable hardware decoding. status is the default and
# is read-only, including the iris firmware check. install and uninstall
# change root-owned files and re-exec with sudo.

set -euo pipefail

rules_dir=${OMARCHY_VIVOBOOK_UDEV_DIR:-/etc/udev/rules.d}
sleep_dir=${OMARCHY_VIVOBOOK_SLEEP_DIR:-/etc/systemd/sleep.conf.d}
iris_dir=${OMARCHY_QUALCOMM_WIREPLUMBER_DIR:-/etc/wireplumber/wireplumber.conf.d}
volume_dir=${OMARCHY_VIVOBOOK_WIREPLUMBER_DIR:-$iris_dir}
rules_file=$rules_dir/90-vivobook-s15-soundwire-no-runtime-pm.rules
sleep_file=$sleep_dir/50-vivobook-s2idle.conf
volume_file=$volume_dir/50-vivobook-s15-speaker-volume.conf
iris_file=$iris_dir/50-hide-qcom-iris-v4l2.conf
iris_file_retired=$iris_dir/50-disable-qcom-iris-v4l2.conf

usage() {
  cat <<'EOF'
Usage: omarchy-hw-vivobook-s5507qa [status|install|uninstall]

status     Show whether these fixes are installed, and whether iris firmware failed
install    Install the fixes this machine qualifies for
uninstall  Remove the speaker, volume, suspend, and PipeWire iris-hide fixes
EOF
}

action=${1:-status}
if (( $# > 1 )); then
  usage >&2
  exit 1
fi

case $action in
  status | install | uninstall) ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

# Fixture directories mean a test. A real install and uninstall write /etc.
under_test=0
if [[ -n ${OMARCHY_VIVOBOOK_UDEV_DIR:-} || -n ${OMARCHY_VIVOBOOK_SLEEP_DIR:-} || -n ${OMARCHY_VIVOBOOK_WIREPLUMBER_DIR:-} || -n ${OMARCHY_QUALCOMM_WIREPLUMBER_DIR:-} || -n ${OMARCHY_SOUNDWIRE_SYSFS:-} ]]; then
  under_test=1
fi

if [[ $action != status ]] && (( EUID != 0 )) && (( under_test == 0 )); then
  if [[ -z ${OMARCHY_PATH:-} ]]; then
    echo "omarchy-hw-vivobook-s5507qa: OMARCHY_PATH is not set" >&2
    exit 1
  fi
  exec sudo -- env PATH="$PATH" OMARCHY_PATH="$OMARCHY_PATH" "$0" "$action"
fi

if [[ -z ${OMARCHY_PATH:-} ]]; then
  echo "omarchy-hw-vivobook-s5507qa: OMARCHY_PATH is not set" >&2
  exit 1
fi

restart_user_wireplumber() {
  local user runtime
  # Tests point the config at a scratch directory. Nothing real is restarted.
  [[ -z ${OMARCHY_QUALCOMM_WIREPLUMBER_DIR:-} ]] || return 0

  user=${SUDO_USER:-}
  if [[ -n $user && $user != root ]]; then
    runtime=/run/user/$(id -u "$user")
    [[ -S $runtime/bus ]] || return 0
    runuser -u "$user" -- env \
      XDG_RUNTIME_DIR="$runtime" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
      systemctl --user try-restart wireplumber.service || true
    return 0
  fi

  runtime=${XDG_RUNTIME_DIR:-}
  if [[ -n $runtime && -S $runtime/bus ]]; then
    systemctl --user try-restart wireplumber.service || true
  fi
}

# Kernel log lines from drivers/media/platform/qcom/iris/iris_firmware.c:
# "firmware download failed -22" and "auth and reset failed: -22". -22 is
# EINVAL from the secure monitor. On Snapdragon X Plus (chip 0xA016) that
# is what the X Elite qcvss8380.mbn gets; the image that loads is
# qcvss8380_pa.mbn from the OEM Windows driver package.
iris_firmware_failed_22() {
  awk '
    BEGIN { IGNORECASE = 1 }
    /qcom-iris/ && /firmware/ && /(^|[^0-9])-22([^0-9]|$)/ { found = 1 }
    /qcom-iris/ && /auth and reset failed:[[:space:]]*-22([^0-9]|$)/ { found = 1 }
    END { exit !found }
  '
}

iris_firmware_status() {
  local log=${OMARCHY_IRIS_KERNEL_LOG:-} text="" checked=0

  if ! omarchy-hw-aarch64-qualcomm; then
    echo "Iris firmware: not a Qualcomm machine"
    return
  fi

  if [[ -n $log ]]; then
    if [[ -r $log ]]; then
      text=$(<"$log")
      checked=1
    fi
  elif (( under_test == 0 )); then
    text=$(dmesg --color=never 2>/dev/null || true)
    if [[ -z $text ]]; then
      text=$(journalctl -k -b --no-pager -o cat 2>/dev/null || true)
    fi
    [[ -n $text ]] && checked=1
  fi

  if (( checked == 0 )); then
    echo "Iris firmware: not checked"
    return
  fi

  if iris_firmware_failed_22 <<<"$text"; then
    echo "Iris firmware: error -22. Snapdragon X Plus (0xA016) needs qcvss8380_pa.mbn from the OEM Windows driver package, not the X Elite qcvss8380.mbn."
  else
    echo "Iris firmware: ok"
  fi
}

status() {
  if omarchy-hw-aarch64-qualcomm && omarchy-hw-match-device-tree asus,vivobook-s15-x1p4; then
    echo "Machine: ASUS Vivobook S 15 S5507QA (Snapdragon X Plus)"
  elif omarchy-hw-aarch64-qualcomm; then
    echo "Machine: Qualcomm, not a Vivobook S 15 S5507QA"
  else
    echo "Machine: not a Vivobook S 15 S5507QA"
  fi

  if [[ -f $rules_file ]]; then
    echo "SoundWire runtime PM: installed"
  else
    echo "SoundWire runtime PM: not installed"
  fi

  if [[ -f $sleep_file ]]; then
    echo "Suspend: s2idle"
  else
    echo "Suspend: kernel default"
  fi

  if [[ -f $volume_file ]]; then
    echo "Speaker volume: capped"
  else
    echo "Speaker volume: unchanged"
  fi

  if [[ -f $iris_file || -f $iris_file_retired ]]; then
    echo "Iris decoder: hidden from PipeWire cameras"
  else
    echo "Iris decoder: not hidden from PipeWire"
  fi

  iris_firmware_status
}

install_fixes() {
  # Firmware when this channel has it, then the speaker, volume, and sleep files.
  bash -euo pipefail -c 'source "$OMARCHY_PATH/install/hardware/asus/fix-asus-vivobook-s15-xplus.sh"'
  bash "$OMARCHY_PATH/install/hardware/qualcomm/disable-iris-v4l2.sh" install
  if omarchy-hw-aarch64-qualcomm; then
    restart_user_wireplumber
  fi
}

uninstall_fixes() {
  local had_iris=0
  if [[ -f $iris_file || -f $iris_file_retired ]]; then
    had_iris=1
  fi
  bash "$OMARCHY_PATH/install/hardware/asus/vivobook-s5507qa.sh" uninstall
  bash "$OMARCHY_PATH/install/hardware/qualcomm/disable-iris-v4l2.sh" uninstall
  if (( had_iris == 1 )); then
    restart_user_wireplumber
  fi
  echo "Removed the Vivobook S15 speaker, volume, and suspend fixes and the Qualcomm rule that hides the iris decoder from PipeWire."
  echo "Install them again with: omarchy hw vivobook s5507qa install"
}

case $action in
  status)
    status
    ;;
  install)
    install_fixes
    ;;
  uninstall)
    uninstall_fixes
    ;;
esac
